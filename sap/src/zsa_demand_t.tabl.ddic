@EndUserText.label : 'ZSA demand long text and acceptance criteria'
@AbapCatalog.enhancement.category : #EXTENSIBLE_ANY
@AbapCatalog.tableCategory : #TRANSPARENT
@AbapCatalog.deliveryClass : #A
@AbapCatalog.dataMaintenance : #RESTRICTED
define table zsa_demand_t {

  key mandt     : mandt not null;
  key demand_id : abap.char(000032) not null;
  @AbapCatalog.textLanguage
  key lang      : abap.lang not null;
  description   : abap.string(000000);
  acceptance    : abap.string(000000);
}
