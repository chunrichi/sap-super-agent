# Server-side model provider (BYOK). Never commit real keys.
# Self-hosted or security-agreement providers are expected; see docs/005.
SA_AI_PROVIDER=openai-compatible
SA_AI_BASE_URL=https://api.example.com/v1
SA_AI_API_KEY=
SA_AI_MODEL=

# M1 local control plane
SA_STATE_DIR=.sap-superagent/state
SA_HTTP_PORT=3080
SA_PUBLIC_URL=http://127.0.0.1:3080

# S2: SAP ICF + MIME integration (leave empty until S2)
SA_SAP_BASE_URL=
SA_SAP_SERVICE_USER=
SA_SAP_SERVICE_PASSWORD=
SA_SAP_HOOK_SECRET=
