@EndUserText.label : 'ZSA artifact metadata projection'
@AbapCatalog.enhancement.category : #EXTENSIBLE_CHARACTER_NUMERIC
@AbapCatalog.tableCategory : #TRANSPARENT
@AbapCatalog.deliveryClass : #A
@AbapCatalog.dataMaintenance : #RESTRICTED
define table zsa_artifact {

  key mandt       : mandt not null;
  key artifact_id : abap.char(000032) not null;
  demand_id       : abap.char(000032) not null;
  stage_key       : abap.char(000030) not null;
  stage_run_id    : abap.char(000032);
  kind            : abap.char(000030) not null;
  version         : abap.int4 not null;
  checksum        : abap.char(000064) not null;
  content_ref     : abap.char(000255) not null;
  content_type    : abap.char(000128) not null;
  status          : abap.char(000020) not null;
  author_type     : abap.char(000010) not null;
  author_id       : abap.char(000040) not null;
  created_at      : timestampl not null;
}
