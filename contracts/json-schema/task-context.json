{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "task": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$"
        },
        "demandId": {
          "type": "string",
          "pattern": "^[0-9a-f]{32}$"
        },
        "stageRunId": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "executorKind": {
          "type": "string",
          "enum": [
            "vscode",
            "server-ai"
          ]
        },
        "requiredRoles": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "requester",
              "consultant",
              "developer",
              "ops"
            ]
          }
        },
        "workspaceBinding": {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "repo": {
                  "type": "string",
                  "minLength": 1
                },
                "projectKey": {
                  "type": "string",
                  "minLength": 1
                },
                "baseBranch": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "required": [
                "repo"
              ],
              "additionalProperties": false
            },
            {
              "type": "null"
            }
          ]
        },
        "priority": {
          "type": "string",
          "enum": [
            "high",
            "normal",
            "low"
          ]
        },
        "dueAt": {
          "anyOf": [
            {
              "type": "string",
              "format": "date-time",
              "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
            },
            {
              "type": "null"
            }
          ]
        },
        "state": {
          "type": "string",
          "enum": [
            "pending",
            "claimed",
            "in_progress",
            "completed",
            "failed",
            "cancelled"
          ]
        },
        "lastHolderUserIds": {
          "maxItems": 3,
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
        }
      },
      "required": [
        "id",
        "demandId",
        "stageRunId",
        "title",
        "executorKind",
        "requiredRoles",
        "workspaceBinding",
        "priority",
        "dueAt",
        "state",
        "lastHolderUserIds",
        "createdAt",
        "updatedAt"
      ],
      "additionalProperties": false
    },
    "demand": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[0-9a-f]{32}$"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string"
        },
        "acceptanceCriteria": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "priority": {
          "type": "string",
          "enum": [
            "high",
            "normal",
            "low"
          ]
        },
        "requester": {
          "type": "object",
          "properties": {
            "userId": {
              "type": "string",
              "minLength": 1
            },
            "orgUnit": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "userId"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "id",
        "title",
        "description",
        "acceptanceCriteria",
        "priority",
        "requester"
      ],
      "additionalProperties": false
    },
    "stage": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "key": {
              "type": "string",
              "minLength": 1
            },
            "name": {
              "type": "string",
              "minLength": 1
            },
            "outputArtifactKind": {
              "type": "string",
              "enum": [
                "requirement_analysis",
                "dev_spec",
                "code_change",
                "test_doc",
                "knowledge_entry",
                "free_note"
              ]
            }
          },
          "required": [
            "key",
            "name",
            "outputArtifactKind"
          ],
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    },
    "inputArtifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "artifactId": {
            "type": "string",
            "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$"
          },
          "version": {
            "type": "integer",
            "exclusiveMinimum": 0,
            "maximum": 9007199254740991
          },
          "kind": {
            "type": "string",
            "enum": [
              "requirement_analysis",
              "dev_spec",
              "code_change",
              "test_doc",
              "knowledge_entry",
              "free_note"
            ]
          },
          "summary": {
            "type": [
              "string",
              "null"
            ]
          },
          "contentRef": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "artifactId",
          "version",
          "kind",
          "summary",
          "contentRef"
        ],
        "additionalProperties": false
      }
    },
    "workspaceBinding": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "repo": {
              "type": "string",
              "minLength": 1
            },
            "projectKey": {
              "type": "string",
              "minLength": 1
            },
            "baseBranch": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "repo"
          ],
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    },
    "allowedActions": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "forbiddenActions": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "generatedAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
    }
  },
  "required": [
    "task",
    "demand",
    "stage",
    "inputArtifacts",
    "workspaceBinding",
    "allowedActions",
    "forbiddenActions",
    "generatedAt"
  ],
  "additionalProperties": false
}
