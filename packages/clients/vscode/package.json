{
  "name": "sap-superagent-vscode",
  "displayName": "SAP Super Agent",
  "description": "Task inbox for SAP Super Agent: claim tasks, open context packs, report artifacts.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/chunrichi/sap-super-agent.git",
    "directory": "packages/clients/vscode"
  },
  "version": "1.0.0",
  "private": true,
  "publisher": "sap-superagent",
  "type": "module",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": ["Other"],
  "main": "./dist/extension.cjs",
  "activationEvents": [
    "onView:sapSuperAgent.inbox",
    "onCommand:sapSuperAgent.connect",
    "onCommand:sapSuperAgent.bindWorkspace",
    "onCommand:sapSuperAgent.claimTask",
    "onCommand:sapSuperAgent.openTask",
    "onCommand:sapSuperAgent.submitArtifact",
    "onCommand:sapSuperAgent.toggleAccepting"
  ],
  "contributes": {
    "commands": [
      { "command": "sapSuperAgent.connect", "title": "SAP Super Agent: 连接控制平面" },
      { "command": "sapSuperAgent.bindWorkspace", "title": "SAP Super Agent: 绑定当前工作区" },
      { "command": "sapSuperAgent.claimTask", "title": "SAP Super Agent: 领取任务" },
      { "command": "sapSuperAgent.openTask", "title": "SAP Super Agent: 打开任务" },
      { "command": "sapSuperAgent.submitArtifact", "title": "SAP Super Agent: 提交工件" },
      { "command": "sapSuperAgent.toggleAccepting", "title": "SAP Super Agent: 暂停/恢复接单" }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "sapSuperAgent",
          "title": "SAP Super Agent",
          "icon": "$(inbox)"
        }
      ]
    },
    "views": {
      "sapSuperAgent": [
        { "id": "sapSuperAgent.inbox", "name": "任务箱" }
      ]
    },
    "viewsWelcome": [
      {
        "view": "sapSuperAgent.inbox",
        "contents": "尚未连接控制平面。\n[连接控制平面](command:sapSuperAgent.connect)",
        "when": "!sapSuperAgent.connected"
      },
      {
        "view": "sapSuperAgent.inbox",
        "contents": "已连接控制平面，暂无待办。\n[领取任务](command:sapSuperAgent.claimTask)\n新的任务或门禁到达时会自动刷新。",
        "when": "sapSuperAgent.connected"
      }
    ],
    "configuration": {
      "title": "SAP Super Agent",
      "properties": {
        "sapSuperAgent.controlPlaneUrl": {
          "type": "string",
          "default": "http://127.0.0.1:3080",
          "description": "控制平面地址（M1 本地模式默认）"
        },
        "sapSuperAgent.accepting": {
          "type": "boolean",
          "default": true,
          "description": "是否接受新任务"
        }
      }
    }
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "bundle": "node ../../../scripts/vsix-package.mjs --bundle-only",
    "build": "pnpm run bundle",
    "package:vsix": "node ../../../scripts/vsix-package.mjs",
    "check": "pnpm run typecheck && pnpm run test"
  },
  "dependencies": {
    "@sap-superagent/protocol": "workspace:*",
    "ws": "^8.22.1"
  }
}
