@EndUserText.label : 'ZSA outbound event outbox (at-least-once push)'
@AbapCatalog.enhancement.category : #EXTENSIBLE_ANY
@AbapCatalog.tableCategory : #TRANSPARENT
@AbapCatalog.deliveryClass : #A
@AbapCatalog.dataMaintenance : #RESTRICTED
define table zsa_event_out {

  key mandt    : mandt not null;
  key event_id : abap.char(000032) not null;
  type         : abap.char(000040) not null;
  demand_id    : abap.char(000032);
  payload      : abap.string(000000);
  state        : abap.char(000010) not null;
  attempts     : abap.int4 not null;
  next_at      : timestampl not null;
  created_at   : timestampl not null;
  changed_at   : timestampl not null;
}
