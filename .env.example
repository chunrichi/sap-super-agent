# Server-side model provider (BYOK). Never commit real keys.
# Default is the offline fake provider, so copying this file just works.
# To call a real model: set SA_AI_PROVIDER=openai-compatible and fill the three
# SA_AI_* BYOK values below (see docs/005 §3.3).
SA_AI_PROVIDER=fake
SA_AI_BASE_URL=
SA_AI_API_KEY=
SA_AI_MODEL=

# M1 local control plane
SA_STATE_DIR=.sap-superagent/state
SA_HTTP_PORT=3080
SA_PUBLIC_URL=http://127.0.0.1:3080

# S2: SAP ICF + MIME integration (leave empty until S2)
SA_SAP_BASE_URL=
SA_SAP_SERVICE_USER=
SA_SAP_SERVICE_PASSWORD=
SA_SAP_HOOK_SECRET=

# S5/M3: SAP-batch AI executor (docs/003 §4.8, deployment docs/010 §4).
# Leave SA_SAP_AI_BATCH unset/0 to keep H0–S4 behaviour (local provider).
# Enable only with SA_SAP_HOOK_SECRET set (same secret as the SAP secure store).
# Defaults shown; override only when the site needs different lease/batch values.
#SA_SAP_AI_BATCH=1
#SA_SAP_AI_STAGE_KEYS=
#SA_SAP_AI_JOB_LEASE_MS=600000
#SA_SAP_AI_JOB_MAX_AGE_MS=1800000
#SA_SAP_AI_JOB_BATCH_SIZE=5
#SA_SAP_AI_JOB_TIMEOUT_MS=120000
#SA_SAP_AI_JOB_MAX_LEASE_EXPIRIES=2
# Model pinned into job payloads: set SA_AI_MODEL above (SAP may fall back to
# ZSA_CFG.AI_GATEWAY_MODEL).
