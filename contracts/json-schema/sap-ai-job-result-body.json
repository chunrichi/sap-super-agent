              "maxLength": 4000
            },
            "retryable": {
              "type": "boolean"
            }
          },
          "required": [
            "message"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "claimId",
        "status",
        "error"
      ],
      "additionalProperties": false
    }
  ]
}
