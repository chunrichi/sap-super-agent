{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "claimId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "usage": {
          "type": "object",
          "properties": {
            "promptTokens": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "completionTokens": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "totalTokens": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "model": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            }
          },
          "additionalProperties": false
        },
        "durationMs": {
          "type": "integer",
          "minimum": 0,
          "maximum": 3600000
        },
        "status": {
          "type": "string",
          "const": "succeeded"
        },
        "outputText": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000000
        }
      },
      "required": [
        "claimId",
        "status",
        "outputText"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "claimId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "usage": {
          "type": "object",
          "properties": {
            "promptTokens": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "completionTokens": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "totalTokens": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "model": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            }
          },
          "additionalProperties": false
        },
        "durationMs": {
          "type": "integer",
          "minimum": 0,
          "maximum": 3600000
        },
        "status": {
          "type": "string",
          "const": "failed"
        },
        "error": {
          "type": "object",
          "properties": {
            "code": {
              "type": "string",
              "minLength": 1,
              "maxLength": 64
            },
            "message": {
