{
  "name": "@sap-superagent/testkit",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Test harness: in-memory repositories, fake AI/executor/SAP, e2e walking skeleton.",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "e2e": "vitest run --config vitest.e2e.config.ts",
    "build": "tsc -p tsconfig.build.json",
    "check": "pnpm run typecheck && pnpm run test"
  },
  "dependencies": {
    "@sap-superagent/protocol": "workspace:*",
    "@sap-superagent/core": "workspace:*"
  },
  "devDependencies": {
    "@sap-superagent/ai": "workspace:*",
    "@sap-superagent/server": "workspace:*"
  }
}
