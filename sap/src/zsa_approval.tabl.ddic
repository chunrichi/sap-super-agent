@EndUserText.label : 'ZSA gate approval audit trail'
@AbapCatalog.enhancement.category : #EXTENSIBLE_ANY
@AbapCatalog.tableCategory : #TRANSPARENT
@AbapCatalog.deliveryClass : #A
@AbapCatalog.dataMaintenance : #RESTRICTED
define table zsa_approval {

  key mandt        : mandt not null;
  key approval_id  : abap.char(000032) not null;
  demand_id        : abap.char(000032) not null;
  stage_key        : abap.char(000030);
  gate_key         : abap.char(000030) not null;
  state            : abap.char(000020) not null;
  required_role    : abap.char(000040);
  decided_by       : abap.char(000012);
  decided_at       : timestampl;
  decision_comment : abap.string(000000);
}
