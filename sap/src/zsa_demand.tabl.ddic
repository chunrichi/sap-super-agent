@EndUserText.label : 'ZSA demand master (S2 SAP demand system)'
@AbapCatalog.enhancement.category : #EXTENSIBLE_CHARACTER_NUMERIC
@AbapCatalog.tableCategory : #TRANSPARENT
@AbapCatalog.deliveryClass : #A
@AbapCatalog.dataMaintenance : #RESTRICTED
define table zsa_demand {

  key mandt        : mandt not null;
  key demand_id    : abap.char(000032) not null;
  demand_no        : abap.char(000012) not null;
  title            : abap.char(000200) not null;
  req_user         : abap.char(000012) not null;
  org_unit         : abap.char(000040);
  priority         : abap.char(000010) not null;
  template_id      : abap.char(000040) not null;
  template_version : abap.numc(000004) not null;
  repo_key         : abap.char(000064);
  project_key      : abap.char(000040);
  status           : abap.char(000020) not null;
  status_text      : abap.char(000040) not null;
  stage_key        : abap.char(000030);
  version          : abap.int4 not null;
  created_at       : timestampl not null;
  changed_at       : timestampl not null;
  sap_note         : abap.char(000255);
}
