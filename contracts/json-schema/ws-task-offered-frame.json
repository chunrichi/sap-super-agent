{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "type": {
      "type": "string",
      "const": "task.offered"
    },
    "at": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
    },
    "subject": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "task"
        },
        "id": {
          "type": "string",
          "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$"
        }
      },
      "required": [
        "type",
        "id"
      ],
      "additionalProperties": false
    },
    "task": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$"
        },
        "demandId": {
          "type": "string",
          "pattern": "^[0-9a-f]{32}$"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "executorKind": {
          "type": "string",
          "enum": [
            "vscode",
            "server-ai"
          ]
        },
        "requiredRoles": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "requester",
              "consultant",
              "developer",
              "ops"
            ]
          }
        },
        "workspaceBinding": {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "repo": {
                  "type": "string",
                  "minLength": 1
                },
                "projectKey": {
                  "type": "string",
                  "minLength": 1
                },
                "baseBranch": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "required": [
                "repo"
              ],
              "additionalProperties": false
            },
            {
              "type": "null"
            }
          ]
        },
        "priority": {
          "type": "string",
          "enum": [
            "high",
            "normal",
            "low"
          ]
        },
        "dueAt": {
          "anyOf": [
            {
              "type": "string",
              "format": "date-time",
              "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "id",
        "demandId",
        "title",
        "executorKind",
        "requiredRoles",
        "workspaceBinding",
        "priority",
        "dueAt"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "type",
    "at",
    "subject",
    "task"
  ],
  "additionalProperties": false
}
